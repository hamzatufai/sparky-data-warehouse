create or replace   view SPARKIFY_DB.STAGING.staging_events
  
  
  
  
  as (
    -- =============================================================================
-- staging_events.sql
-- Parses the raw VARIANT event payloads into typed columns and filters down
-- to only "NextSong" events, since those are the only rows that represent
-- an actual song play (other page values are things like "Login", "Home").
-- Materialized as a VIEW in SPARKIFY_DB.STAGING - cheap re-computation over
-- the RAW table, no duplicated storage.
-- =============================================================================

-- source() resolves to SPARKIFY_DB.RAW.RAW_EVENTS via _staging__sources.yml,
-- so this model never needs to hardcode the physical table location.
with source as (

    select * from SPARKIFY_DB.RAW.raw_events

),

-- Pull each field out of the VARIANT payload with the ':' path operator and
-- cast it to its proper type, since VARIANT fields are untyped by default.
parsed as (

    select
        -- User identifiers and profile attributes.
        raw_payload:userId::int                          as user_id,
        raw_payload:firstName::varchar                   as first_name,
        raw_payload:lastName::varchar                    as last_name,
        raw_payload:gender::varchar                      as gender,
        raw_payload:level::varchar                       as level,

        -- Session / event context.
        raw_payload:sessionId::int                       as session_id,
        raw_payload:itemInSession::int                   as item_in_session,
        raw_payload:page::varchar                        as page,
        raw_payload:location::varchar                    as location,
        raw_payload:userAgent::varchar                   as user_agent,

        -- Song-play specific attributes. These three are the only keys the
        -- event log shares with the song catalog (there is no song_id here).
        raw_payload:song::varchar                        as song_title,
        raw_payload:artist::varchar                      as artist_name,
        raw_payload:length::float                        as duration,

        -- Timestamps arrive as epoch milliseconds. Keep the raw bigint, which
        -- is the actual key used by time.start_time and songplays.start_time,
        -- and also expose a real TIMESTAMP for date math in the time model.
        raw_payload:ts::bigint                           as start_time,
        to_timestamp_ntz(raw_payload:ts::bigint / 1000)   as event_timestamp,

        -- Lineage columns carried through from the RAW table.
        source_file_name,
        loaded_at

    from source

)

-- Keep only actual song-play events. Every other `page` value (e.g.
-- "Home", "Login", "Logout", "Help") is navigation, not a play, and would
-- pollute the songplays fact if left in.
select *
from parsed
where page = 'NextSong'
  )
