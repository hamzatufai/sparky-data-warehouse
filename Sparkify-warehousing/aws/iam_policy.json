{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeS3ObjectReadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::sparkify-dw-bucket/*"
    },
    {
      "Sid": "SnowflakeS3BucketListAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::sparkify-dw-bucket-hamza/*",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "log_data/*",
            "song_data/*"
          ]
        }
      }
    }
  ]
}
